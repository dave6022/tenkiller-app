# Copy to .env and fill in.
#
# Mapbox public token. `pk.*` tokens are designed to be shipped in the browser
# bundle, so this is not a secret in the way a `sk.*` token is — but it is
# scrapeable and it spends your quota, so restrict it to your own URLs in the
# Mapbox dashboard (Account -> Tokens -> the token -> URL restrictions).
#
# Free tier is 50,000 map loads/month at time of writing.
VITE_MAPBOX_TOKEN=
